# Copy to .env (gitignored) and fill in. Loaded by `npm run dev:server` only;
# tests and CI never read it. Variables already set in your shell take precedence.

# Local Postgres from `npm run db:up` (use port 5433 if JAT_DB_PORT=5433).
DATABASE_URL=postgres://jat:jat@127.0.0.1:5432/jat

# Google sign-in and Gmail import (Google Cloud console -> Clients -> your web client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail import: Claude classifies the emails (console.anthropic.com -> API Keys).
ANTHROPIC_API_KEY=
# Comma-separated user ids allowed to import from Gmail.
GMAIL_IMPORT_USER_IDS=
