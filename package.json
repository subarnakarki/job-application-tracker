{
  "name": "job-application-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web",
    "e2e",
    "evals"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:server": "npm run dev -w @jat/server",
    "dev:web": "npm run dev -w @jat/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "build:api": "esbuild server/src/vercel.ts --bundle --platform=node --format=esm --target=node24 --banner:js=\"import { createRequire as __cr } from \\\"node:module\\\"; const require = __cr(import.meta.url);\" --outfile=build/handler.mjs",
    "db:migrate": "npm run db:migrate -w @jat/server",
    "openapi": "npm run openapi -w @jat/server",
    "test:e2e": "npm test -w @jat/e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "esbuild": "^0.28.2"
  }
}
